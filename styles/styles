@media (max-width: 768px) {
    .products {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 500px) {
    .products {
        grid-template-columns: 1fr;
    }

    header {
        flex-direction: column;
    }

    nav {
        flex-direction: column;
    }
}
/* Botões visíveis no tema claro */
.account-btn {
    background: #ffffff;
    color: #241b16;
    border: 1px solid #cfc3b7;
    border-radius: 10px;
    padding: 10px 12px;
    font-weight: bold;
    cursor: pointer;
}

.account-btn.primary {
    background: #df492f;
    color: #ffffff;
    border-color: #df492f;
}

.add {
    background: #fff0e9;
    color: #c23822;
    border: 1px solid #f1c5b8;
}

.chip {
    background: #ffffff;
    color: #241b16;
    border: 1px solid #d9cfc4;
}

.chip.active {
    background: #241b16;
    color: #ffffff;
}

.detail-btn {
    background: transparent;
    color: #c23822;
    font-weight: bold;
    cursor: pointer;
}

button:focus-visible {
    outline: 3px solid #f4b942;
    outline-offset: 2px;
}
// edição da API dos usauarios


.clientes {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 20px;
}

.cliente {
  padding: 20px;
  text-align: center;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #ddd;
  overflow-wrap: anywhere;
}

.cliente img {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  object-fit: cover;
}

.cliente h3 {
  margin: 12px 0 8px;
}

.cliente p {
  font-size: 14px;
  color: #746c65;
}

@media (max-width: 600px) {
  .clientes {
    grid-template-columns: 1fr;
  }
}
